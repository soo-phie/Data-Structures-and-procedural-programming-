Problem 1: Sum of distinct elements of two sets (using arrays)
Distinct elements = elements that appear in only one of the two sets.
Algorithm SumDistinct
Variables
    A[1..n], B[1..m] : array of integers
    n, m, i, j, sum  : integers
    found            : boolean
Begin
    Read(n)
    For i <- 1 to n do
        Read(A[i])
    EndFor
    Read(m)
    For j <- 1 to m do
        Read(B[j])
    EndFor

    sum <- 0

    // Step 1: elements of A that are not in B
    For i <- 1 to n do
        found <- false
        For j <- 1 to m do
            If A[i] = B[j] then
                found <- true
            EndIf
        EndFor
        If found = false then
            sum <- sum + A[i]
        EndIf
    EndFor

    // Step 2: elements of B that are not in A (vice versa)
    For j <- 1 to m do
        found <- false
        For i <- 1 to n do
            If B[j] = A[i] then
                found <- true
            EndIf
        EndFor
        If found = false then
            sum <- sum + B[j]
        EndIf
    EndFor

    Write("Sum of distinct elements = ", sum)
End
Trace with A = [3, 1, 7, 9], B = [2, 4, 1, 9, 3]:
Not in B: 7, so sum = 7
Not in A: 2 and 4, so sum = 7 + 2 + 4 = 13
Problem 2: Dot product and orthogonality
Vectors are stored in arrays. Parameter passing used:
D = input by value (data)
R = result (output by reference / address)
D/R = data/result (input and output)
2a. Version with a procedure
Procedure dot_product(D v1[1..d] : array of real,
                      D v2[1..d] : array of real,
                      D d        : integer,
                      R ps       : real)
Variables
    k : integer
Begin
    ps <- 0
    For k <- 1 to d do
        ps <- ps + v1[k] * v2[k]
    EndFor
End

Algorithm Orthogonality
Variables
    V1[1..d], V2[1..d] : array of real
    n, d, i, k         : integer
    ps                 : real
Begin
    Read(n)              // number of pairs of vectors
    Read(d)              // dimension of the vectors (e.g. 2 or 3)

    For i <- 1 to n do                 // outer loop: each pair
        For k <- 1 to d do             // nested loop: read components
            Read(V1[k])
        EndFor
        For k <- 1 to d do
            Read(V2[k])
        EndFor

        dot_product(V1, V2, d, ps)     // ps is passed by reference

        If ps = 0 then
            Write("Pair ", i, " : the vectors are orthogonal")
        Else
            Write("Pair ", i, " : the vectors are NOT orthogonal")
        EndIf
    EndFor
End
2b. Modified version with a function
Function dot_product(D v1[1..d] : array of real,
                     D v2[1..d] : array of real,
                     D d        : integer) : real
Variables
    k  : integer
    ps : real
Begin
    ps <- 0
    For k <- 1 to d do
        ps <- ps + v1[k] * v2[k]
    EndFor
    Return ps
End

Algorithm Orthogonality
Variables
    V1[1..d], V2[1..d] : array of real
    n, d, i, k         : integer
    ps                 : real
Begin
    Read(n)
    Read(d)

    For i <- 1 to n do
        For k <- 1 to d do
            Read(V1[k])
        EndFor
        For k <- 1 to d do
            Read(V2[k])
        EndFor

        ps <- dot_product(V1, V2, d)   // result returned, no reference needed

        If ps = 0 then
            Write("Pair ", i, " : the vectors are orthogonal")
        Else
            Write("Pair ", i, " : the vectors are NOT orthogonal")
        EndIf
    EndFor
End
